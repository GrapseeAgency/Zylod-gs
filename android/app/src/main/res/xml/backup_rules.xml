<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <!-- The encrypted session store must NEVER be backed up: its AES key lives
         in this device's Android Keystore, so a restored copy is undecryptable
         ciphertext that made EncryptedSharedPreferences throw (AEADBadTag)
         on every access after a device transfer/cloud restore (D4 fix). -->
    <exclude domain="sharedpref" path="zylod_secure.xml"/>
    <!-- t206 B7: the local cart is ACCOUNT-SCOPED device state. Restoring it
         onto another device/user makes pullServerCart POST the previous
         account's rows into the new account's server cart on first login —
         a cross-account data leak. It never travels with a backup. -->
    <exclude domain="sharedpref" path="zylod_cart.xml"/>
    <!-- t279: zylod_config holds ~60 account-scoped offline caches (wallet
         balance, bank accounts, invoices, addresses, DM threads,
         notifications …) in ONE file alongside the server-config pair.
         Backup rules are file-granular and the account data is strictly more
         sensitive than the cart, so the whole file never travels — same
         cross-account rationale as zylod_cart (B7). The only loss on restore
         is the chosen server URL, which the provenance probe re-selects. -->
    <exclude domain="sharedpref" path="zylod_config.xml"/>
</full-backup-content>
