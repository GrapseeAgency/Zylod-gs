# ─────────────────────────────────────────────────────────────
# Zylod environment configuration
# Copy to .env and fill in. Everything below works OUT OF THE BOX
# in sandbox/demo mode with the public sandbox credentials shown.
# ─────────────────────────────────────────────────────────────

# Public origin of this deployment — used for gateway callbacks and QR links.
# MUST be publicly reachable (bKash/SSLCommerz redirect users back here).
# For local testing use an ngrok URL, e.g. https://xxxx.ngrok-free.app
APP_URL=http://localhost:3000

# ── bKash Tokenized Checkout (direct) ────────────────────────
# Defaults below are bKash's PUBLIC SANDBOX credentials.
# Sandbox test wallet: 01770618575 · PIN 12121 · OTP 123456
# Production keys: register at the bKash Merchant Portal (call 16247),
# then set BKASH_MODE=live and replace all four values.
BKASH_MODE=sandbox
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345

# ── SSLCommerz (cards + Nagad/Rocket/Upay aggregation) ───────
# Defaults below are SSLCommerz's PUBLIC SANDBOX credentials (testbox).
# Cards cannot use Stripe: Stripe does not support merchants registered in
# Bangladesh — SSLCommerz is the card route (Visa/Mastercard/Amex + MFS).
# Production: https://developer.sslcommerz.com → Registration → set mode live.
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/zylod

# ── Auth JWT ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Admin bootstrap ──────────────────────────────────────────
# Admin accounts can ONLY be created while the platform has ZERO admins
# (first-admin window, POST /api/auth/register userType=admin). After that,
# registration is closed — set this secret to allow creating further admin
# accounts by passing it as adminBootstrapSecret in the same register call.
# Leave unset in production unless you actually need remote admin minting.
# ADMIN_BOOTSTRAP_SECRET=

# ── Payment webhook (HMAC) ───────────────────────────────────
# POST /api/payments/webhook is the only AUTOMATED path that marks an order
# paid. It requires this shared secret: callers sign the raw body with
# HMAC-SHA256 and send it as `x-zylod-signature: sha256=<hex>`. Unset = the
# webhook honestly returns 503 (channel not configured) — it never fakes
# success. The MANUAL leg (buyer submit → seller/admin verify) does not
# need this secret.
# PAYMENT_WEBHOOK_SECRET=

# ── Socket.io mini-service (real-time) ───────────────────────
# Loopback control surface the Next.js API routes use to broadcast events
# (order:*, product:stock, payment:*, rfq:*, ...). Default works locally.
# DELIVERY_SOCKET_URL=http://127.0.0.1:3006
# Comma-separated browser origins allowed to open the socket connection.
# Default '*' (any). On Railway set this to your real app origin(s), e.g.
# https://zylod.up.railway.app — the mini-service reads it at boot.
# SOCKET_ALLOWED_ORIGINS=*

# ── Seller video upload cap (MB) ─────────────────────────────
# POST /api/upload/video rejects files bigger than this with an honest 413.
# VIDEO_MAX_MB=50
