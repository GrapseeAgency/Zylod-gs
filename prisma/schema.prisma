generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Core Identity
// ============================================================

model users {
  id             String   @id @default(cuid())
  // userType: buyer | supplier | admin
  userType       String
  email          String?  @unique
  phone          String?  @unique
  passwordHash   String?
  // authProvider: phone_otp | google | email
  authProvider   String
  googleId       String?
  // accountStatus: active | suspended | banned
  accountStatus  String   @default("active")
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  twoFactorSecret String?
  isTwoFactorEnabled Boolean @default(false)
  // Suspension metadata (set when accountStatus != active)
  suspensionReason  String?
  suspensionRef     String?
  suspendedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Core relations
  buyerProfile       buyerProfiles?
  supplierProfile    supplierProfiles?
  addresses          addresses[]
  otpCodes           otpCodes[]
  sessions           sessions[]
  backupCodes        backupCodes[]
  carts              carts[]
  orders             orders[]
  wishlists          wishlists[]
  notifications      notifications[]
  notificationPrefs  notificationPreferences?
  priceAlerts       priceAlerts[]
  stockAlerts       stockAlerts[]
  deliveryAlerts    deliveryAlerts[]
  conversations      conversations[]
  conversations2     conversations[] @relation("SupplierConversations")
  messages           messages[]
  quoteRequests      quoteRequests[]
  quoteRequests2     quoteRequests[] @relation("SupplierQuotes")
  reviews            reviews[]
  supplierReviews    supplierReviews[]
  productQas         productQas[]
  auditLogs          auditLogs[] @relation("ActorAuditLogs")
  blogPosts          blogPosts[]
  creditLines        creditLines[]
  creditLines2       creditLines[] @relation("SupplierCreditLines")

  // Flash Deals & Promotions
  browsingHistory    browsingHistory[]
  compareItems       compareItems[]

  // Wishlist & Favorites
  savedForLater      savedForLater[]
  collections        collections[]

  // RFQ System
  rfqRequests        rfqRequests[]

  // Sample Orders
  sampleOrders       sampleOrders[]

  // Inspection
  inspectionRequests inspectionRequests[]

  // Loyalty & Rewards
  buyerRewards       buyerRewards?
  rewardTransactions rewardTransactions[]
  referralCodes      referralCodes[]
  referralUses       referralUses[] @relation("ReferredUser")

  // Wallet & Escrow
  wallets            wallets[]
  paymentMethods     paymentMethods[]
  walletTopups      walletTopups[]
  reportedIssues     reportedIssues[] @relation("IssueReporter")

  // Admin & Content
  apiKeys            apiKeys[]
  pushTokens         pushTokens[]

  // Search & Navigation
  searchHistory      searchHistory[]

  // Support & Help
  supportTickets     supportTickets[]
  contactSubmissions contactSubmissions[]

  @@index([userType])
  @@index([accountStatus])
}

model otpCodes {
  id           String   @id @default(cuid())
  // Null until the account exists (pre-registration verification codes)
  userId       String?
  phoneOrEmail String
  codeHash     String
  // purpose: register | login | reset_password | phone_verify | email_verify | 2fa
  purpose      String
  expiresAt    DateTime
  isUsed       Boolean  @default(false)

  user users? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneOrEmail])
}

// One-time 2FA recovery codes — stored hashed, plaintext shown to the user exactly once
model backupCodes {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model sessions {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  // device info for multi-device tracking
  deviceInfo String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ============================================================
// Buyer
// ============================================================

model buyerProfiles {
  id               String  @id @default(cuid())
  userId           String  @unique
  fullName         String
  businessName     String?
  // businessType: individual | retailer | distributor | wholesaler | manufacturer
  businessType     String  @default("individual")
  defaultAddressId String? @unique
  profileCompletionPct Int @default(0)
  isProfileComplete   Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress addresses? @relation("BuyerDefaultAddress", fields: [defaultAddressId], references: [id])
}

model newsletterSubscribers {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model addresses {
  id           String  @id @default(cuid())
  userId       String
  label        String
  companyName  String?
  contactName  String?
  contactPhone String?
  addressLine1 String
  addressLine2 String?
  city         String
  district     String
  postalCode   String
  country      String  @default("Bangladesh")
  lat          Float?
  lng          Float?
  isDefault    Boolean @default(false)

  user               users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             orders[]
  buyerDefaultAddress buyerProfiles?  @relation("BuyerDefaultAddress")
  supplierWarehouse   supplierProfiles? @relation("SupplierWarehouse")
  sampleOrders       sampleOrders[]

  @@index([userId])
  @@index([district])
}

// ============================================================
// Supplier (KYC)
// ============================================================

model supplierProfiles {
  id                 String  @id @default(cuid())
  userId             String  @unique
  companyName        String
  nidNumber          String
  nidFrontImageUrl   String
  nidBackImageUrl    String
  tradeLicenseNumber String
  tradeLicenseImageUrl String
  tinNumber          String
  bankAccountName    String
  bankAccountNumber  String
  bankName           String
  branch             String
  warehouseAddressId String? @unique
  // verificationStatus: pending | under_review | approved | rejected
  verificationStatus String  @default("pending")
  rejectionReason    String?
  verifiedBy         String?
  verifiedAt         DateTime?
  ratingAvg          Float   @default(0)
  ratingCount        Int     @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseAddress  addresses?      @relation("SupplierWarehouse", fields: [warehouseAddressId], references: [id])
  products          products[]
  supplierAgreements supplierAgreements[]
  supplierReviews    supplierReviews[]

  // Supplier Enhancements
  warehouseLocations warehouseLocations[]
  supplierLocations  supplierLocations[]
  supplierCampaigns  supplierCampaigns[]
  supplierLoyaltyTiers supplierLoyaltyTiers[]

  // Sample Orders
  sampleOrders       sampleOrders[] @relation("SupplierSampleOrders")

  // RFQ Quotes
  rfqQuotes          rfqQuotes[]

  // Seller Enhancement Relations
  verificationDocuments  sellerVerificationDocuments[]
  sellerPromotions       sellerPromotions[]
  shippingConfigs        sellerShippingConfigs[]
  returnPolicies         sellerReturnPolicies[]
  supportTickets        sellerSupportTickets[]
  storeCustomization    sellerStoreCustomizations?
  payouts              sellerPayouts[]
  bulkUploads          sellerBulkUploads[]
  customerQueries      sellerCustomerQueries[]

  @@index([verificationStatus])
}

model supplierAgreements {
  id            String   @id @default(cuid())
  supplierId    String
  // agreementType: terms_of_service | nda | supplier_contract | quality_agreement
  agreementType String
  documentUrl   String
  signedAt      DateTime
  expiresAt     DateTime?

  supplier supplierProfiles @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// ============================================================
// Catalog
// ============================================================

model categories {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  iconUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  parent   categories?  @relation("CategoryTree", fields: [parentId], references: [id])
  children categories[] @relation("CategoryTree")
  products products[]

  // Market Insights
  marketReports marketReports[]

  @@index([parentId])
  @@index([isActive])
}

model products {
  id           String   @id @default(cuid())
  supplierId   String
  categoryId   String
  name         String
  slug         String
  sku          String?
  description  String
  brand        String?
  // unit: pcs | dozen | kg | carton | box | set
  unit         String   @default("pcs")
  moq          Int      @default(1)
  maxOrderQty  Int?
  basePrice    Float
  // currency default BDT
  currency     String   @default("BDT")
  stockQuantity Int
  isActive       Boolean  @default(true)
  isApproved     Boolean  @default(false)
  isCustomizable Boolean  @default(false)
  // Discovery merchandising flags
  isClearance    Boolean  @default(false)
  isSeasonal     Boolean  @default(false)
  thumbnailUrl   String?
  soldCount      Int      @default(0)
  ratingAvg      Float    @default(0)
  reviewCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier      supplierProfiles    @relation(fields: [supplierId], references: [id])
  category      categories          @relation(fields: [categoryId], references: [id])
  images        productImages[]
  priceTiers    productPriceTiers[]
  variants      productVariants[]
  cartItems     cartItems[]
  orderItems    orderItems[]
  reviews       reviews[]
  wishlists     wishlists[]
  quoteRequests quoteRequests[]
  conversations conversations[]
  savedForLater savedForLater[]
  collectionItems collectionItems[]


  // Product Enhancement
  specifications   productSpecifications[]
  tagRelations     productTagRelations[]
  videos           productVideos[]
  certifications   productCertifications[]
  qas              productQas[]

  // Flash Deals & Promotions
  flashDeals       flashDeals[]
  dailyDeals       dailyDeals[]
  promotionProducts promotionProducts[]

  // Browsing & Compare
  browsingHistory  browsingHistory[]
  compareItems     compareItems[]

  // Visual Search — CLIP embedding of the thumbnail (JSON float array)
  embedding      String?
  embeddingModel String?

  // Sample Orders
  sampleOrders     sampleOrders[]



  @@index([supplierId])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([isApproved])
  @@index([basePrice])
  @@index([createdAt])
  @@index([soldCount])
  @@index([ratingAvg])
}

model productImages {
  id        String @id @default(cuid())
  productId String
  imageUrl  String
  sortOrder Int    @default(0)

  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model productQas {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  question   String
  answer     String?
  answeredBy String? // user id of the answering supplier
  answeredAt DateTime?
  helpful    Int      @default(0)
  createdAt  DateTime @default(now())

  product products @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    users    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
}

model productPriceTiers {
  id          String @id @default(cuid())
  productId   String
  minQty      Int
  maxQty      Int?
  pricePerUnit Float

  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model productVariants {
  id            String  @id @default(cuid())
  productId     String
  variantName   String
  variantValue  String
  sku           String?
  stockQuantity Int
  priceOverride Float?

  product   products   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems cartItems[]
  orderItems orderItems[]

  @@index([productId])
}

// ============================================================
// Cart & Orders
// ============================================================

model carts {
  id       String   @id @default(cuid())
  buyerId  String
  createdAt DateTime @default(now())

  buyer users      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items cartItems[]

  @@index([buyerId])
}

model cartItems {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  supplierId String
  addedAt   DateTime @default(now())

  cart    carts            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product products         @relation(fields: [productId], references: [id])
  variant productVariants? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([productId])
}

model orders {
  id               String  @id @default(cuid())
  buyerId          String
  orderNumber      String  @unique
  totalAmount      Float
  // paymentStatus: unpaid | partial | paid | refunded
  paymentStatus    String  @default("unpaid")
  shippingAddressId String?
  placedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  buyer           users      @relation(fields: [buyerId], references: [id])
  shippingAddress addresses? @relation(fields: [shippingAddressId], references: [id])
  subOrders       subOrders[]
  payments        payments[]

  // Cross Border & Customs
  crossBorderOrder crossBorderOrders?

  // Escrow
  escrowAccounts  escrowAccounts[]

  // Inspection
  inspectionRequests inspectionRequests[]

  @@index([buyerId])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([placedAt])
}

model subOrders {
  id               String   @id @default(cuid())
  orderId          String
  supplierId       String
  subtotal         Float
  shippingCost     Float?
  // status: pending | confirmed | packed | shipped | delivered | cancelled | returned
  status           String   @default("pending")
  trackingNumber   String?
  estimatedDelivery DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order orders     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items orderItems[]

  // Order Tracking
  trackingHistory orderTracking[]

  @@index([orderId])
  @@index([supplierId])
  @@index([status])
}

model orderItems {
  id         String  @id @default(cuid())
  subOrderId String
  productId  String
  variantId  String?
  quantity   Int
  unitPrice  Float
  totalPrice Float

  subOrder subOrders        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  product  products         @relation(fields: [productId], references: [id])
  variant  productVariants? @relation(fields: [variantId], references: [id])

  @@index([subOrderId])
  @@index([productId])
}

// ============================================================
// Payments
// ============================================================

model payments {
  id              String   @id @default(cuid())
  orderId         String
  // method: cod | bank_transfer | card | mobile_banking | wallet
  method          String
  amount          Float
  // status: pending | success | failed | refunded
  status          String   @default("pending")
  transactionId   String?
  gatewayResponse String?
  paidAt          DateTime?

  order orders @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

// ============================================================
// Negotiation
// ============================================================

model quoteRequests {
  id           String   @id @default(cuid())
  buyerId      String
  supplierId   String
  productId    String?
  requestedQty Int
  message      String
  quotedPrice  Float?
  // status: pending | quoted | accepted | rejected | expired
  status       String   @default("pending")
  validUntil   DateTime?
  createdAt    DateTime @default(now())

  buyer    users     @relation(fields: [buyerId], references: [id])
  supplier users     @relation("SupplierQuotes", fields: [supplierId], references: [id])
  product  products? @relation(fields: [productId], references: [id])

  @@index([buyerId])
  @@index([supplierId])
  @@index([status])
}

// ============================================================
// Chat
// ============================================================

model conversations {
  id            String   @id @default(cuid())
  buyerId       String
  supplierId    String
  productId     String?
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())

  buyer    users     @relation(fields: [buyerId], references: [id])
  supplier users     @relation("SupplierConversations", fields: [supplierId], references: [id])
  product  products? @relation(fields: [productId], references: [id])
  messages messages[]

  @@index([buyerId])
  @@index([supplierId])
  @@index([lastMessageAt])
}

model messages {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  messageText    String
  attachmentUrl  String?
  attachmentType String? // 'image' | 'file' | null
  attachmentName String? // original filename for display
  replyToId      String? // id of the message being replied to
  isRead         Boolean  @default(false)
  sentAt         DateTime @default(now())

  conversation conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       users        @relation(fields: [senderId], references: [id])
  replyTo      messages?    @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      messages[]   @relation("MessageReply")

  @@index([conversationId])
  @@index([senderId])
  @@index([sentAt])
}

// ============================================================
// Supporting
// ============================================================

model reviews {
  id        String   @id @default(cuid())
  productId String
  buyerId   String
  rating    Int
  comment   String?
  // Verified-purchase flag (set when the buyer has a delivered order for this product)
  verifiedPurchase Boolean  @default(false)
  // Review image urls (JSON string array) — e.g. ["/uploads/reviews/xx.jpg"]
  images    String? // JSON array of image URLs
  // replyToId — for reply-to-review threads
  replyToId String?
  createdAt DateTime @default(now())

  product products @relation(fields: [productId], references: [id])
  buyer   users    @relation(fields: [buyerId], references: [id])
  replyTo reviews?  @relation("ReviewReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies reviews[] @relation("ReviewReply")

  @@index([productId])
  @@index([buyerId])
  @@index([rating])
  @@index([replyToId])
}

model supplierReviews {
  id        String   @id @default(cuid())
  supplierId String
  buyerId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  supplier supplierProfiles @relation(fields: [supplierId], references: [id])
  buyer    users            @relation(fields: [buyerId], references: [id])

  @@index([supplierId])
  @@index([buyerId])
}

model wishlists {
  id        String   @id @default(cuid())
  buyerId   String
  productId String
  // note: optional buyer note on the wishlist item
  note      String?
  createdAt DateTime @default(now())

  buyer   users    @relation(fields: [buyerId], references: [id])
  product products @relation(fields: [productId], references: [id])

  @@unique([buyerId, productId])
  @@index([buyerId])
  @@index([productId])
}

model savedForLater {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  movedFrom String   @default("cart") // cart | wishlist
  createdAt DateTime @default(now())

  user    users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model collections {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  coverImage  String?
  isPublic    Boolean  @default(false)
  // shareToken for public shared link
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items collectionItems[]

  @@index([userId])
  @@index([shareToken])
}

model collectionItems {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  note         String?
  addedAt      DateTime @default(now())

  collection collections @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    products    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model notifications {
  id              String   @id @default(cuid())
  userId          String
  // type: order | payment | promotion | system | chat | review
  type            String
  title           String
  body            String
  isRead          Boolean  @default(false)
  relatedEntityId String?
  createdAt       DateTime @default(now())

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model auditLogs {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entityType String
  entityId  String?
  // metadata stored as JSON string
  metadata  String?
  createdAt DateTime @default(now())

  actor users? @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}

model coupons {
  id              String   @id @default(cuid())
  code            String   @unique
  // type: percentage | fixed
  discountType    String   @default("percentage")
  discountPercent Float
  maxDiscount     Float?
  minOrderAmount  Float?
  validFrom       DateTime
  validUntil      DateTime
  usageLimit      Int?
  usedCount       Int      @default(0)
  isActive        Boolean  @default(true)

  @@index([code])
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
}

model blogPosts {
  id            String   @id @default(cuid())
  authorId      String?
  title         String
  slug          String   @unique
  content       String
  excerpt       String?
  coverImageUrl String?
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author users? @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([isPublished])
  @@index([publishedAt])
}

model creditLines {
  id              String   @id @default(cuid())
  buyerId         String
  supplierId      String?
  creditLimit     Float
  usedCredit      Float   @default(0)
  availableCredit Float
  interestRate    Float?
  // status: active | suspended | closed
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyer    users  @relation(fields: [buyerId], references: [id])
  supplier users? @relation("SupplierCreditLines", fields: [supplierId], references: [id])

  @@index([buyerId])
  @@index([supplierId])
  @@index([status])
}

// ============================================================
// Flash Deals & Promotions
// ============================================================

model flashDeals {
  id             String   @id @default(cuid())
  productId      String
  dealPrice      Float
  discountPercent Float
  startAt        DateTime
  endAt          DateTime
  totalStock     Int
  soldCount      Int      @default(0)
  maxPerBuyer    Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([startAt])
  @@index([endAt])
}

model dailyDeals {
  id             String   @id @default(cuid())
  productId      String
  dealPrice      Float
  discountPercent Float
  dayDate        DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([dayDate])
  @@index([isActive])
}

model banners {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkPageId  String?
  linkParams  String?
  // position: home_top | home_middle | category_top | sidebar
  position    String   @default("home_top")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime @default(now())

  @@index([position])
  @@index([isActive])
  @@index([sortOrder])
}

model promotions {
  id             String   @id @default(cuid())
  name           String
  description    String?
  // type: percentage | fixed | bogo | bundle
  type           String
  value          Float
  minOrderAmount Float?
  maxDiscount    Float?
  validFrom      DateTime
  validUntil     DateTime
  usageLimit     Int?
  usedCount      Int      @default(0)
  isActive       Boolean  @default(true)
